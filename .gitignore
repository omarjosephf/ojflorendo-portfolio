# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; the example (names only) IS committed
.env*
!.env.example

# editor / OS cruft (never commit swap or backup files)
Thumbs.db
*.swp
*~
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documents — never commit PDFs (e.g. a private/unredacted CV) by default.
# If a redacted, public-download CV is later added deliberately, force-add that
# exact file (git add -f) or add a specific allowlist entry for it here.
*.pdf
# Exact reviewed public CV permitted by the approved publication plan.
!/public/documents/OJ_Florendo_Rayatchi_Public_CV.pdf
# The assistant corpus copy of that same reviewed CV. A test asserts it stays
# byte-identical to the file above, and its digest is part of the committed
# corpus checksum — so leaving it ignored made the recorded checksum
# unreproducible from a clean checkout. Exact path only: the blanket rule above
# still applies to every other PDF.
!/content/assistant/OJ_Florendo_Rayatchi_Public_CV.pdf

# Certificate documents, published by the owner's decision of 31 August 2026.
# Exact paths only — the blanket *.pdf rule above deliberately stays in force for
# everything else, including the private CVs and invoices that sit beside these
# files in the owner's source folder. Publication record, review status and
# SHA-256 per file: docs/certificates/README.md.
!/public/documents/certificates/pcep-python-institute-2025.pdf
!/public/documents/certificates/business-intelligence-lpc-2025.pdf
!/public/documents/certificates/ux-ui-designer-bootcamp-school-of-ux-design-2023.pdf
!/public/documents/certificates/analyze-data-with-excel-codecademy-2025.pdf
!/public/documents/certificates/prompt-engineering-dubai-future-foundation-2025.pdf
!/public/documents/certificates/art-of-storytelling-iese-2025.pdf

# Public repository guidance is tracked at the root. Ignore only private/local
# AI-tooling instructions and state; never copy their contents into tracked files.
/CLAUDE.local.md
/AGENTS.local.md
/.claude/
/.agents/

# test / automation artefacts (if ever added inside the repo)
/test-results/
/playwright-report/
/playwright/.cache/
